{
  "name": "shupit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "npm run web -w @shupit/app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "emulators": "firebase emulators:start --project shupit-8a4f5",
    "test:rules": "firebase emulators:exec --only firestore --project shupit-8a4f5 \"npm run test:rules -w @shupit/contracts\"",
    "typecheck:api": "tsc --noEmit -p api && tsc --noEmit -p tests",
    "test:api": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
