# Server-only secrets for Vercel Functions (set in Vercel project settings, never commit).
# base64 of the Firebase service-account JSON:
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Anthropic API key for screenshot/link extraction (server-only). Without it /api/extract returns 503.
ANTHROPIC_API_KEY=
# Shipment tracking aggregator (Ship24). Without it the refresh cron is a no-op and statuses stay "not verified".
SHIP24_API_KEY=
# Shared secret Vercel Cron sends as a bearer token to /api/cron/*
CRON_SECRET=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
